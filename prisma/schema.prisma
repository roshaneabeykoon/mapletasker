// MapleTasker database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  category    String
  urgency     String
  location    String
  budget      Decimal
  description String?
  status      String   @default("open") // open, claimed, done, cancelled
  magicToken  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Soft delete: rows are never removed, so unlocks stay auditable.
  deletedAt DateTime?
}

model Tasker {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  tokenBalance Int                 @default(0)
  createdAt    DateTime            @default(now())
  unlocks      Unlock[]
  transactions WalletTransaction[]

  /// Null until the tasker clicks their verification link. The signup token
  /// grant is withheld until this is set, so creating throwaway accounts
  /// doesn't farm free unlocks.
  emailVerifiedAt     DateTime?
  verificationTokens  EmailVerificationToken[]
}

/// One-time link a new tasker must click to confirm their address and
/// receive the signup token grant. Deleted once used, so it can't be replayed.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  taskerId  String
  tasker    Tasker   @relation(fields: [taskerId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([taskerId])
}

model Unlock {
  id        String   @id @default(uuid())
  taskerId  String
  taskId    String
  tasker    Tasker   @relation(fields: [taskerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([taskerId, taskId])
}

/// One row per throttled attempt. Rows are counted within a time window and
/// pruned once stale — see src/lib/rate-limit.ts.
model RateLimitHit {
  id        String   @id @default(uuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model WalletTransaction {
  id              String   @id @default(uuid())
  taskerId        String
  tasker          Tasker   @relation(fields: [taskerId], references: [id])
  type            String // signup_grant, unlock_spend, stripe_topup
  amount          Int
  stripePaymentId String?
  createdAt       DateTime @default(now())
}
 