# Copy this file to `.env.local` and fill in your own values.
#
# Local Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If your local Postgres has no password (e.g. Postgres.app defaults),
# omit the ":PASSWORD" part entirely.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mapletasker_dev?schema=public"

# Resend API key, used to email clients their magic link when they post a task.
# Get one at https://resend.com/api-keys. If this is unset the app still works —
# the email is skipped and the link is logged plus shown on the confirmation page.
RESEND_API_KEY="re_your_api_key_here"

# "From" address for transactional email. Must be on a domain you've verified in
# Resend. Leave unset in development to use Resend's shared onboarding sender,
# which can only deliver to your own Resend account address (or the test inbox
# delivered@resend.dev).
EMAIL_FROM="MapleTasker <onboarding@resend.dev>"

# Base URL used to build magic links inside emails. Set this to your real
# domain in production.
APP_URL="http://localhost:3000"

# REQUIRED. Signs the tasker session cookie (JWT). Generate one with:
#   openssl rand -base64 32
# Changing this value invalidates every existing session.
SESSION_SECRET="generate_me_with_openssl_rand_base64_32"
